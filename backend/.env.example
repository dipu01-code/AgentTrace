APP_NAME=AgentTrace
APP_ENV=development
DEBUG=true
API_V1_STR=/api/v1
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=agenttrace
CORS_ORIGINS=["*"]
# Required when APP_ENV=production. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET=<long random string>
STUCK_AFTER_MINUTES=10
STUCK_CHECK_INTERVAL_SECONDS=60
